# Server Port
PORT=3000

# Firebase Realtime Database URL
FIREBASE_DB_URL=https://chika-c61d6-default-rtdb.firebaseio.com

# Optional: Google Gemini API Key for Smart Natural Language Parser
# Dapatkan gratis di: https://aistudio.google.com/
# Jika kosong, sistem otomatis menggunakan Indonesian NLP Parser bawaan yang sangat akurat.
GEMINI_API_KEY=

# Optional: WhatsApp Gateway Integration
# 1. Fonnte (https://fonnte.com): Masukkan token akun Fonnte untuk auto-reply via API
FONNTE_TOKEN=

# 2. Meta WhatsApp Cloud API Verify Token
WA_VERIFY_TOKEN=chika_finance_secret

